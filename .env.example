# Copy to .env and replace every value marked CHANGE_ME. Never commit .env.
# Generate secrets with:  python -c "import secrets; print(secrets.token_urlsafe(48))"

# --- database -------------------------------------------------------------
POSTGRES_DB=maintenix
POSTGRES_USER=maintenix
POSTGRES_PASSWORD=CHANGE_ME_db_password

# --- API --------------------------------------------------------------------
# At least 32 random characters. The API refuses weak secrets when ENVIRONMENT=production.
JWT_SECRET=CHANGE_ME_long_random_secret_at_least_32_chars
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:8080,http://localhost:5173
LOG_LEVEL=INFO

# First administrator (created once, on first start). 10+ chars, mixed case, a digit.
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_Admin1

# --- demo -------------------------------------------------------------------
# SEED_DEMO creates 12 SIMULATED equipment items and four demo users that share DEMO_USER_PASSWORD.
# Set SEED_DEMO=false for any non-demo deployment.
SEED_DEMO=true
DEMO_USER_PASSWORD=CHANGE_ME_Demo1
# Train models on SIMULATED data on first start when the models volume is empty.
TRAIN_ON_START=true
# Download the real NASA C-MAPSS FD001 dataset (checksum verified), train turbofan models and,
# with SEED_DEMO, import 8 real test engines. Falls back to simulated data only if the download fails.
CMAPSS=true

# --- ports ------------------------------------------------------------------
WEB_PORT=8080
API_PORT=8000
